# MediaBot environment configuration
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env

# Required — from BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# Required — free key from https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Required — from https://www.watchmode.com/
WATCHMODE_API_KEY=

# Optional — SQLite database path (default: movies.db)
DB_FILE=movies.db

# Optional — seconds between streaming-availability refreshes (default: 1 week)
REFRESH_INTERVAL_SECONDS=604800

# Optional — local Ollama server (defaults shown)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:12b-it-qat
# Seconds to wait for a parse response; cold model loads can be slow
OLLAMA_TIMEOUT=60
# How long Ollama keeps the model resident between requests (avoids cold reloads)
OLLAMA_KEEP_ALIVE=30m

# Optional — dashboard bind address/port (defaults shown)
HOST=0.0.0.0
PORT=8000

# Optional — Watchmode region for streaming sources (default: US)
WATCHMODE_REGION=US
